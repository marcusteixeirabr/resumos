---
import { getCollection } from 'astro:content';
import QuizPageLayout from '../../layouts/QuizPageLayout.astro';

const entries = (await getCollection('teste-software'))
  .sort((a, b) => a.data.ua - b.data.ua);
const banks = (await getCollection('exercicios-teste-software'))
  .sort((a, b) => a.data.ua - b.data.ua);
const bank = banks.map((item) => ({
  ua: item.data.ua,
  questions: item.data.questions,
}));
---
<QuizPageLayout
  disciplineTitle="Teste de Software"
  base="/teste-software"
  entries={entries}
  bank={bank}
/>
