---
import { getCollection } from 'astro:content';
import QuizPageLayout from '../../layouts/QuizPageLayout.astro';

const entries = (await getCollection('paradigmas-programacao'))
  .sort((a, b) => a.data.ua - b.data.ua);
const banks = (await getCollection('exercicios-paradigmas-programacao'))
  .sort((a, b) => a.data.ua - b.data.ua);
const bank = banks.map((item) => ({
  ua: item.data.ua,
  questions: item.data.questions,
}));
---
<QuizPageLayout
  disciplineTitle="Paradigmas de Programação"
  base="/paradigmas-programacao"
  entries={entries}
  bank={bank}
/>
