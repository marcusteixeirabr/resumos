---
import { getCollection, getEntry, render } from 'astro:content';
import DisciplineLayout from '../../layouts/DisciplineLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('dispositivos-moveis');
  return entries.map(entry => ({
    params: { slug: entry.id },
    props:  { entry, entries },
  }));
}

const { entry, entries } = Astro.props;
const { Content } = await render(entry);
const sorted = [...entries].sort((a, b) => a.data.ua - b.data.ua);
const exerciseEntry = await getEntry('exercicios-dispositivos-moveis', entry.id);
const exercises = exerciseEntry?.data.questions;
---
<DisciplineLayout
  entry={entry}
  entries={sorted}
  disciplineTitle="Programação para Dispositivos Móveis"
  base="/dispositivos-moveis"
  exercises={exercises}
>
  <Content />
</DisciplineLayout>
