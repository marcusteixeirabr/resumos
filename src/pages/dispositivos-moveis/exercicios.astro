---
import { getCollection } from 'astro:content';
import QuizPageLayout from '../../layouts/QuizPageLayout.astro';

const entries = (await getCollection('dispositivos-moveis'))
  .sort((a, b) => a.data.ua - b.data.ua);
const banks = (await getCollection('exercicios-dispositivos-moveis'))
  .sort((a, b) => a.data.ua - b.data.ua);
const bank = banks.map((item) => ({
  ua: item.data.ua,
  questions: item.data.questions,
}));
---
<QuizPageLayout
  disciplineTitle="Programação para Dispositivos Móveis"
  base="/dispositivos-moveis"
  entries={entries}
  bank={bank}
/>
